[Unit]
Description=OCI Distribution Registry
Documentation=https://github.com/project-zot/zot
After=network.target auditd.service local-fs.target
Requires=zot.socket

[Service]
# Type=notify requires a zot build that sends sd_notify (READY=1). Older binaries
# will time out waiting for readiness. Raise TimeoutStartSec if Init is slow
# (e.g. first-time CVE DB download).
Type=notify
NotifyAccess=main
TimeoutStartSec=5min
ExecStart=/usr/bin/zot serve /etc/zot/config.json
Restart=on-failure
User=zot
Group=zot
LimitNOFILE=500000

[Install]
WantedBy=multi-user.target
