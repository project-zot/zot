{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/tmp/zot"
  },
  "http": {
    "address": "127.0.0.1",
    "port": "8080",
    "realm": "zot",
    "auth": {
      "htpasswd": {
        "path": "/tmp/htpasswd"
      }
    },
    "accessControl": {
      "disableAnonymousCatalog": true,
      "repositories": {
        "**": {
          "anonymousPolicy": [
            "read"
          ],
          "policies": [
            {
              "users": ["alice"],
              "actions": ["read"]
            }
          ]
        }
      }
    }
  },
  "log": {
    "level": "debug"
  }
}
